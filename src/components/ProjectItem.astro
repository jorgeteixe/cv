---
interface Props {
  project: {
    name: string;
    description: string;
    highlights?: string[];
    keywords: string[];
    date?: string;
    url?: string;
    roles?: string[];
    entity?: string;
    type?: string;
    links?: { label: string; url: string }[];
  };
}

const { project } = Astro.props;

const formatDate = (dateString: string) => {
  if (!dateString) return "";
  const date = new Date(dateString);
  return date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
};

const formattedDate = project.date ? formatDate(project.date) : "";
---

<div class="mb-4">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start mb-2 gap-1 sm:gap-0">
    <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 flex-1 min-w-0">
      <h3 class="font-semibold text-base break-words">
        {project.name}
      </h3>
      {(project.url || (project.links && project.links.length > 0)) && (
        <div class="flex flex-wrap gap-1">
          {project.url && (
            <a
              href={project.url}
              class="inline-flex items-center px-2 py-1 text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 rounded border border-blue-200 transition-colors"
              target="_blank"
              rel="noopener"
              title="Repository"
            >
              Repo
            </a>
          )}
          {project.links && project.links.map((link) => (
            <a
              href={link.url}
              class="inline-flex items-center px-2 py-1 text-xs bg-blue-50 text-blue-700 hover:bg-blue-100 rounded border border-blue-200 transition-colors"
              target="_blank"
              rel="noopener"
              title={link.label}
            >
              {link.label}
            </a>
          ))}
        </div>
      )}
    </div>
    {formattedDate && (
      <span class="text-xs text-gray-500 whitespace-nowrap sm:ml-4">{formattedDate}</span>
    )}
  </div>
  
  <p class="text-sm text-gray-700 mb-2 leading-relaxed">
    {project.description}
  </p>
  
  {project.highlights && project.highlights.length > 0 && (
    <ul class="text-sm text-gray-700 mb-2 list-disc list-inside space-y-1">
      {project.highlights.map((highlight) => (
        <li>{highlight}</li>
      ))}
    </ul>
  )}
  
  <div class="flex flex-wrap gap-2">
    {project.keywords.map((keyword) => (
      <span class="px-2 py-1 bg-gray-100 text-xs rounded">
        {keyword}
      </span>
    ))}
  </div>
</div>